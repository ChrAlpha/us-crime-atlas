{
  "name": "us-crime-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first travel-area visualization using official local crime incident data and MapLibre GL JS.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:data": "node scripts/check-data-sources.mjs && node scripts/check-runtime-queries.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.57.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
